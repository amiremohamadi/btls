WHITESPACE = _{ (" " | "\t" | "\r" | "\n")+ }
SPACE      = _{ " " | "\t" }
COMMENT    = _{ "//" ~ (!NEWLINE ~ ANY)* ~ NEWLINE? }
NEWLINE    = _{ "\r\n" | "\n" }

identifier = @{ ("_" | ASCII_ALPHA) ~ ("_" | ASCII_ALPHANUMERIC)* }
string     = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
number     = @{ ASCII_DIGIT+ }

struct_kw = { "struct" | "union" }
ptr       = { "*" }
type_name = { struct_kw? ~ identifier ~ ptr* }

scratch_var = { "$" ~ identifier }
map_var     = { "@" ~ (identifier ~ map_keys? | map_keys)? }
variable    = { scratch_var | map_var }
map_keys    =  { "[" ~ expr_list ~ "]" }

macro_param     = { scratch_var | map_var | identifier }
macro_params    = { macro_param ~ ("," ~ macro_param)* }

primary   =  {
    string
  | number
  | call
  | cast
  | paren_expr
  | arg_n
  | identifier
  | variable
}

cast        =  { "(" ~ type_name ~ ")" ~ expr }
paren_expr  = { "(" ~ expr ~ ")" }
arg_n       = @{ "arg" ~ ASCII_DIGIT+ }

infix       = _{ add | sub | mul | div | mod | le | lt | ge | gt | eq | ne | and | or }
prefix      = _{ not | inc_prefix | dec_prefix | neg | pos | deref }
postfix     = _{ inc_postfix | dec_postfix | field_access }
field_access = { ("->" | ".") ~ identifier? }

add         =  { "+" }
sub         =  { "-" }
mul         =  { "*" }
div         =  { "/" }
mod         =  { "%" }
le          =  { "<=" }
lt          =  { "<" }
ge          =  { ">=" }
gt          =  { ">" }
eq          =  { "==" }
ne          =  { "!=" }
and         =  { "&&" }
or          =  { "||" }
not         =  { "!" }
neg         =  { "-" }
pos         =  { "+" }
deref       =  { "*" }
inc_prefix  =  { "++" }
inc_postfix =  { "++" }
dec_prefix  =  { "--" }
dec_postfix =  { "--" }

expr      =  { prefix* ~ primary ~ postfix* ~ (infix ~ prefix* ~ primary ~ postfix*)* }
expr_list =  { expr ~ ("," ~ expr)* }

assign_op  =  { "=" | "+=" | "-=" }
assignment =  { variable ~ assign_op ~ expr }
call       =  { identifier ~ "(" ~ expr_list? ~ ")" }
if         =  { "if" ~ "(" ~ expr ~ ")" ~ block ~ else? }
else       =  { "else" ~ (if | block) }
while      =  { "while" ~ "(" ~ expr ~ ")" ~ block }
for        =  { "for" ~ "(" ~ expr ~ ":" ~ expr ~ ")" ~ block }
unroll     =  { "unroll" ~ "(" ~ number ~ ")" ~ block }
macro_def  =  { "macro" ~ identifier ~ "(" ~ macro_params? ~ ")" ~ block }
base_stmt  = _{ assignment | expr }
statement  =  { if | while | for | unroll | base_stmt ~ ";"? }
block      =  { "{" ~ (COMMENT | statement | error)* ~ ("}" | EOI) }

attach_point      = @{ (identifier | ":" | "*")+ }
attach_point_list = { attach_point ~ ("," ~ attach_point)* }
probe_condition   = { "/" ~ expr ~ "/" }
probe             = { attach_point_list ~ probe_condition? ~ block }

cdef         = { include | define | struct_def }
include      = ${ "#include" ~ SPACE+ ~ include_path }
include_path = @{ "<" ~ (!(">" | NEWLINE) ~ ANY)* ~ ">" }
define       = ${ "#define" ~ SPACE+ ~ identifier ~ (SPACE+ ~ define_body)? }
define_body  = @{ (!NEWLINE ~ ANY)+ }
struct_def   = { struct_kw ~ identifier ~ "{" ~ (field_decl | COMMENT | error)* ~ "}" ~ ";"? }
field_decl   = { type_name ~ identifier ~ array_suffix? ~ ";" }
array_suffix = { "[" ~ number ~ "]" }

cfg_value  = { identifier | number | string }
cfg_assign = { identifier ~ "=" ~ cfg_value? ~ ";"? }
cfg_block  = { "config" ~ "=" ~ "{" ~ (COMMENT | cfg_assign | error)* ~ "}" }

preamble          = { cfg_block | cdef | macro_def | probe }
error             =  { rest_of_line }
rest_of_line      = @{ (!(NEWLINE | "}") ~ ANY)+ ~ NEWLINE? }
unmatched_brace   = { "}" }
program           = { SOI ~ (COMMENT | preamble | error | unmatched_brace)* ~ EOI }
